migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# This repository targets Android and iOS. Keep the local desktop/web files,
# but do not include them when uploading the mobile project.
/linux/
/web/
/windows/

# Local editor settings and machine-specific tool configuration
.vscode/
*.code-workspace
Thumbs.db
Desktop.ini
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/
/android/.kotlin/
**/.cxx/
**/.externalNativeBuild/
/ios/build/
**/DerivedData/
**/xcuserdata/
*.xcuserstate
**/Pods/
**/.symlinks/
/ios/Flutter/ephemeral/
.flutter-plugins

# Downloaded SDK/framework outputs and generated registration/configuration
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GeneratedPluginRegistrant.*
/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Build products and debugging/export outputs are downloaded from Actions,
# not committed as source files.
*.apk
*.aab
*.ipa
*.xcarchive/
*.dSYM/
*.hprof

# Signing material, private keys and local secrets. In CI use repository
# Actions Secrets; base64-encoding a certificate does not make it public-safe.
key.properties
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
.env
.env.*
!.env.example
!.env.template
/secrets/
/credentials/
/.aws/
/.codex/

# Intentionally KEEP: lib/, android/ and ios/ source/resources/projects,
# pubspec.yaml, pubspec.lock, .metadata, analysis_options.yaml, test/, stm32/,
# docs/, THIRD_PARTY_NOTICES.md and .github/workflows/. These are useful for
# reproducible CI, regression checks and protocol/reference documentation.
